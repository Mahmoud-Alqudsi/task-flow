{
    "name": "mahmoud_alqudsi/task-flow",
    "description": "A complete task management system built with raw PHP 8.4 and MySQL",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "mysql", "task-manager", "pdo", "mvc"],
    "authors": [
        {
            "name": "mahmoud_alqudsi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public/",
        "db:create": "mysql -u root -e 'CREATE DATABASE IF NOT EXISTS task_flow CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;'",
        "db:schema": "mysql -u root task_flow < database/schema.sql",
        "db:seed": "mysql -u root task_flow < database/seed.sql"
    }
}